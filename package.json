{
  "name": "@iamhuman.link/presentation-exchange-vue",
  "version": "0.1.0",
  "description": "Frontend helpers and Vue QR component for I Am Human presentation requests.",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "qrcode.vue": "^3.3.4",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.3.0",
    "qrcode.vue": "^3.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.3",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  },
  "license": "ISC"
}
